# Copy to .env and fill in. Secrets can instead live in macOS Keychain —
# scripts/up.sh reads Keychain items named "novak/<VAR>" and they take
# precedence over values here. Keep real tokens OUT of this file if you use
# the Keychain path (recommended; see docs/security.md).

# ── Host ────────────────────────────────────────────────────────────────
# LAN hostname or IP of the mini (used in URLs handed to browsers/HA).
HOST_NAME=mini.local

# ── oMLX ────────────────────────────────────────────────────────────────
# Port the oMLX server listens on — check the oMLX menu bar app / admin UI
# and set it here. Containers reach it via host.docker.internal.
OMLX_PORT=8080
# API key if you enabled auth in oMLX (recommended). Keychain: novak/OMLX_API_KEY
OMLX_API_KEY=changeme

# ── Open WebUI ──────────────────────────────────────────────────────────
OPENWEBUI_PORT=3000

# ── Console + OIDC (Pocket ID) ──────────────────────────────────────────
CONSOLE_PORT=3002
# Session signing key. Generate: openssl rand -base64 32
# Keychain: novak/CONSOLE_AUTH_SECRET
CONSOLE_AUTH_SECRET=changeme
# Pocket ID issuer URL (no trailing slash).
OIDC_ISSUER=https://inti.a64.one
OIDC_CLIENT_ID=changeme
# Keychain: novak/OIDC_CLIENT_SECRET
OIDC_CLIENT_SECRET=changeme
# In Pocket ID, register a redirect URI per hostname you reach the console by
# (LAN name AND Tailscale name if you use both):
#   http://<host>:3002/api/auth/callback/pocketid
# The client must be allowed the `groups` scope — admin gating depends on it.
# Admin group name is hardcoded as `admins.novak` in console/src/lib/authz.ts.

# ── Outline MCP ─────────────────────────────────────────────────────────
# Create an API token in Outline: Settings → API Tokens. Scope it read-only
# unless you want the model writing docs. Keychain: novak/OUTLINE_API_KEY
# Outline serves MCP itself (e.g. https://et.a64.one/mcp) — no wrapper
# container and no port here. The token is configured in the CLIENT's MCP
# registration as an Authorization header, not injected by this stack.
#
# NAMED PER INSTANCE, because there can be several Outlines. The registry entry
# records which key belongs to which instance via its `auth:` field.
#   Keychain: novak/OUTLINE_EVERYTHING_API_KEY   -> et.a64.one  (name: outline-everything)
# Add a second instance as OUTLINE_<INSTANCE>_API_KEY plus a registry entry.
OUTLINE_EVERYTHING_API_KEY=changeme

# Tududi, likewise: generated per user in its Profile settings.
# Keychain: novak/TUDUDI_API_TOKEN
TUDUDI_API_TOKEN=changeme

# ── Vikunja MCP ─────────────────────────────────────────────────────────
# VIKUNJA_URL must end with /api/v1. Destructive ops stay disabled unless
# you opt in via the server's ENABLE_*_DELETE env vars (don't).
# Keychain: novak/VIKUNJA_API_TOKEN
VIKUNJA_URL=https://your-vikunja-host/api/v1
VIKUNJA_API_TOKEN=changeme
# Ports for MCP servers come from registry/mcp-servers.yaml, not from here.

# ── Memory (Hindsight) ──────────────────────────────────────────────────
# Speaks MCP natively; Postgres is embedded in the image. Runs in this
# compose file — see docs/memory-setup.md.
HINDSIGHT_PORT=8888
HINDSIGHT_UI_PORT=9999

# WITHOUT THIS THE MCP ENDPOINT IS OPEN. No authentication, every bank
# readable and writable by anything that can reach the port.
# Generate: openssl rand -hex 32
# Keychain: novak/HINDSIGHT_API_KEY
HINDSIGHT_API_KEY=changeme

# Inference provider. Must point at oMLX so memories are computed locally —
# this is the setting that decides whether your conversations leave the
# machine. Valid values include openai, ollama, lmstudio; oMLX is
# OpenAI-compatible, so `openai` with a local base URL is the right pairing.
HINDSIGHT_LLM_PROVIDER=openai

# ── Wyoming voice services (for HA Voice) ───────────────────────────────
WHISPER_PORT=10300
PIPER_PORT=10200
WHISPER_MODEL=small-int8
PIPER_VOICE=en_US-lessac-medium

# Wake word ("hey novak"). The model file in wakeword/models/ must be named
# to match — see wakeword/README.md. Until you've trained one, set this to a
# stock word (e.g. ok_nabu) or the service will fail to preload.
OPENWAKEWORD_PORT=10400
WAKEWORD_MODEL=hey_novak
