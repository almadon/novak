# Copy to $NOVAK_HOME/.env (up.sh does this for you on first run).
#
# ── HOW TO READ THIS FILE ───────────────────────────────────────────────
#
#   EDIT-ME          You must replace this. up.sh lists any that remain.
#   set-in-keychain  A SECRET. Leave this line alone — put the real value in
#                    the macOS Keychain, where it cannot be read out of a file
#                    or committed by accident:
#                        security add-generic-password -s "novak/<VAR>" -a novak -w
#                    up.sh loads Keychain items and they override this file.
#                    Do so AS THE ACCOUNT THAT RUNS THE STACK — the login
#                    keychain is per-user.
#   anything else    A sensible default. Change only if you need to.
#
# ════════════════════════════════════════════════════════════════════════
#  1. MUST EDIT — nothing works properly until these are real
# ════════════════════════════════════════════════════════════════════════

# Hostname or IP other machines use to reach this one. A Tailscale name or
# address is a good choice; `localhost` will not do.
#
# THIS DOES NOT CHANGE WHAT ANYTHING BINDS TO. It is only used to build the
# URLs handed to browsers and to Home Assistant. If a service is unreachable
# from another machine, the cause is its bind address, not this setting —
# run `novak ports` to see which. oMLX in particular binds per its own
# admin-UI setting and defaults to localhost only.
HOST_NAME=EDIT-ME

# Vikunja's API root. Must end in /api/v1.
VIKUNJA_URL=EDIT-ME

# ════════════════════════════════════════════════════════════════════════
#  2. MUST EDIT — only if you are running the optional web console
# ════════════════════════════════════════════════════════════════════════
# Skip these if you are not using Konzol; the stack runs without it.

# Your Pocket ID (or other OIDC provider) base URL, no trailing slash.
OIDC_ISSUER=https://inti.a64.one
# The client ID you registered there. NOT a secret — client IDs are public,
# which is why this one is edited here rather than kept in the Keychain.
OIDC_CLIENT_ID=EDIT-ME

# ════════════════════════════════════════════════════════════════════════
#  3. SECRETS — leave these lines exactly as they are
# ════════════════════════════════════════════════════════════════════════
# Every value below comes from the Keychain. The literal text below is never
# used; it exists so compose has something to interpolate and so you can see
# at a glance what the stack expects.

# oMLX API key (enable auth in oMLX, then store the key).
OMLX_API_KEY=set-in-keychain

# Hindsight. WITHOUT THIS THE MEMORY ENDPOINT IS OPEN — no authentication,
# every bank readable by anything that can reach the port.
#   openssl rand -hex 32
HINDSIGHT_API_KEY=set-in-keychain

# Console session signing key.  openssl rand -base64 32
CONSOLE_AUTH_SECRET=set-in-keychain
# OIDC client secret (this one IS secret, unlike the client ID above).
OIDC_CLIENT_SECRET=set-in-keychain

# Per-endpoint tokens for external MCP servers. One per instance — the
# registry entry names which key belongs to which URL via its `auth:` field.
OUTLINE_EVERYTHING_API_KEY=set-in-keychain
TUDUDI_API_TOKEN=set-in-keychain
VIKUNJA_API_TOKEN=set-in-keychain

# ════════════════════════════════════════════════════════════════════════
#  4. DEFAULTS — fine as they are
# ════════════════════════════════════════════════════════════════════════

# Ports. Change only on a collision.
OMLX_PORT=8080

# Which model Hindsight uses to extract memories. Must be a model oMLX actually
# serves — its own default (gpt-4o-mini) does not exist locally and extraction
# fails silently apart from a line in the logs.
HINDSIGHT_LLM_MODEL=Qwen3-4B-Instruct-2507-4bit

# ── Public addresses (set these when a reverse proxy is in front) ─────────
# HOST_NAME is how machines in this stack reach each other. It is NOT how a
# person reaches a service when a proxy fronts it — that name lives on another
# host, often a public domain, and nothing here can discover it.
#
# Leave blank and services build their URLs from HOST_NAME, which is correct
# for direct access. Set them to the address users actually type, scheme and
# all, with no trailing slash:
#   OWUI_PUBLIC_URL=https://cas.example.tld
#
# Getting this wrong is rarely a hard error. It surfaces as a login that
# bounces you to a hostname you never asked for, or a link in the UI that
# points somewhere unreachable.
OWUI_PUBLIC_URL=
KONZOL_PUBLIC_URL=

# Open WebUI: let its database override these settings. Default false, so .env
# wins and configuration cannot drift out of sight inside a container. Set true
# only if you want to manage Open WebUI from its admin UI instead — and then
# expect changes here to be ignored once its DB has a value.
OWUI_PERSISTENT_CONFIG=false

# ── Open WebUI sign-in via Pocket ID (optional) ───────────────────────────
# Unset means local accounts only, which is a fine place to start. Open WebUI
# reads these at startup and has no admin UI for them, so they belong here.
#
# Needs its OWN Pocket ID client, separate from the console's — the redirect
# URI differs and one client cannot serve both:
#   http://<HOST_NAME>:3000/oauth/oidc/callback
#
# OWUI_OIDC_ISSUER is the discovery document, not the bare issuer:
#   https://<pocket-id-host>/.well-known/openid-configuration
OWUI_OIDC_ISSUER=
OWUI_OIDC_CLIENT_ID=
OWUI_OIDC_CLIENT_SECRET=set-in-keychain
OWUI_OIDC_PROVIDER_NAME=Pocket ID
# Leave blank. It follows OWUI_PUBLIC_URL (or HOST_NAME when that is unset),
# which is what you want — set OWUI_PUBLIC_URL instead. Override only if the
# callback must differ from the site's own address.
#
# Whatever it resolves to must be registered with the IdP EXACTLY, including
# scheme and path. Check the effective value with:
#   docker compose config | grep OPENID_REDIRECT_URI
OWUI_OIDC_REDIRECT_URI=
# true lets anyone your IdP authenticates create an account here.
OWUI_OIDC_SIGNUP=false

# ── Home Assistant MCP (optional; that registry entry ships disabled) ─────
# The ha-mcp entry declares these. It is a `container` entry, so both the URL
# and the token are variables here — unlike `external` entries, which carry
# their URL in registry/mcp-servers.yaml and need only a token.
HA_MCP_URL=
HA_MCP_TOKEN=set-in-keychain
OPENWEBUI_PORT=3000
CONSOLE_PORT=3002
HINDSIGHT_PORT=8888
HINDSIGHT_UI_PORT=9999
WHISPER_PORT=10300
PIPER_PORT=10200
OPENWAKEWORD_PORT=10400

# Hindsight's inference provider. `openai` plus a local base URL points it at
# oMLX — the setting that keeps memory extraction on this machine.
HINDSIGHT_LLM_PROVIDER=openai

# Voice models.
WHISPER_MODEL=small-int8
PIPER_VOICE=en_US-lessac-medium

# Wake word. openwakeword CRASH-LOOPS until a model with this name exists in
# $NOVAK_HOME/wakeword/models/ — set a stock word (e.g. ok_nabu) until you have
# trained one. See wakeword/README.md.
WAKEWORD_MODEL=hey_novak
