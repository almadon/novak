#!/usr/bin/env bash
# novak — a small CLI for running and configuring the stack.
#
# Exists because "edit a file, remember which lines are placeholders, re-run a
# script" is a bad interface for something you touch every few weeks.
#
#   novak status              what's configured, what's running
#   novak ports               what's listening, and whether it's reachable
#   novak drift               where this deployment differs from the repo
#   novak doctor              check config without starting anything
#   novak config              list settings and where each value comes from
#   novak config get KEY
#   novak config set KEY VAL  edit .env in place, preserving comments
#   novak secret set KEY      store a secret in the Keychain (prompts, no echo)
#   novak secret set KEY --generate
#                             generate one and store it, never displaying it.
#                             Refused for secrets another system owns.
#   novak secret show KEY     print one, when a client needs it pasted in
#   novak secret list         which secrets are present (never their values)
#   novak up                  apply config and start
#   novak down                stop, keep data
#   novak restart [SERVICE]
#   novak logs [SERVICE]
#   novak registry            show the MCP registry as the reconciler sees it
#   novak omlx apply          apply registry/omlx.yaml (models, profiles, TTLs)
#
# Add to PATH:  ln -s "$PWD/scripts/novak" /usr/local/bin/novak
set -euo pipefail

# Same defensive PATH as scripts/launch-stack.sh. This is reached through a
# symlink in /usr/local/bin, so it runs under whatever environment the caller
# had — cron, a LaunchAgent, or a login shell that never sourced Homebrew.
# `tailscale` in particular lives only in /opt/homebrew/bin, and when it is
# absent `novak ports` reports no Tailscale address on a machine that is
# perfectly online — indistinguishable from the real thing.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.orbstack/bin:$PATH"

# Resolve symlinks before locating the repo. This script is meant to be linked
# into PATH, and BASH_SOURCE is then the LINK's path — computing the repo from
# it directly lands in /usr/local and nothing is found. `readlink -f` is not
# portable to older macOS, hence the loop.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINKDIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$LINKDIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [ ! -f "$REPO_DIR/scripts/lib/vars.sh" ]; then
  echo "✋ Could not locate the Novak checkout from $0" >&2
  echo "   Resolved to: $REPO_DIR" >&2
  echo "   If this is a symlink, re-create it pointing at scripts/novak in the" >&2
  echo "   checkout:  ln -sf /path/to/novak/scripts/novak /usr/local/bin/novak" >&2
  exit 1
fi
NOVAK_HOME="${NOVAK_HOME:-$HOME/.novak}"
ENV_FILE="$NOVAK_HOME/.env"
source "$REPO_DIR/scripts/lib/vars.sh"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
red()  { printf '\033[31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

need_env() {
  [ -f "$ENV_FILE" ] || { red "No config at $ENV_FILE — run 'novak up' once to seed it."; exit 1; }
}
is_secret()   { local v; for v in "${SECRET_VARS[@]}";     do [ "$v" = "$1" ] && return 0; done; return 1; }
is_external() { local v; for v in "${EXTERNAL_SECRETS[@]}"; do [ "$v" = "$1" ] && return 0; done; return 1; }
is_shared()   { local v; for v in "${SHARED_SECRETS[@]}";   do [ "$v" = "$1" ] && return 0; done; return 1; }
# Where a secret has to be repeated by hand, so rotating one says what it breaks.
secret_kind() {
  if is_external "$1"; then echo "external"
  elif is_shared "$1"; then echo "shared"
  else echo "internal"; fi
}
envval()    { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true ; }
keychain()  { security find-generic-password -s "novak/${1}" -w 2>/dev/null || true; }

cmd_config() {
  need_env
  case "${1:-list}" in
    list)
      bold "Settings   ($ENV_FILE)"
      echo
      printf '  %-30s %-10s %s\n' "SETTING" "SOURCE" "STATUS"
      local key val
      while IFS='=' read -r key val; do
        [[ "$key" =~ ^[A-Z] ]] || continue
        if is_secret "$key"; then
          if [ -n "$(keychain "$key")" ]; then
            printf '  %-30s %-10s %s\n' "$key" "keychain" "$(grn set)"
          else
            printf '  %-30s %-10s %s\n' "$key" "keychain" "$(red MISSING)"
          fi
        elif [[ "$val" =~ $PLACEHOLDERS ]]; then
          printf '  %-30s %-10s %s\n' "$key" ".env" "$(red 'NEEDS EDITING')"
        else
          printf '  %-30s %-10s %s\n' "$key" ".env" "$val"
        fi
      done < <(grep -E '^[A-Z_]+=' "$ENV_FILE")
      echo
      dim "  Secret values are never printed. 'novak secret set KEY' to change one."
      ;;
    get) [ $# -ge 2 ] || { red "usage: novak config get KEY"; exit 1; }
         is_secret "$2" && { red "$2 is a secret — values are not printed. Try 'novak secret list'."; exit 1; }
         envval "$2" ;;
    set)
      [ $# -ge 3 ] || { red "usage: novak config set KEY VALUE"; exit 1; }
      local key="$2"; shift 2; local val="$*"
      is_secret "$key" && { red "$key is a secret. Use: novak secret set $key"; exit 1; }
      grep -qE "^${key}=" "$ENV_FILE" || { red "Unknown setting '$key'. 'novak config' lists them."; exit 1; }
      # In-place, comment-preserving. The delimiter avoids clashing with URLs.
      local tmp; tmp="$(mktemp)"
      awk -v k="$key" -v v="$val" '
        $0 ~ "^" k "=" && !done { print k "=" v; done=1; next } { print }
      ' "$ENV_FILE" > "$tmp" && mv "$tmp" "$ENV_FILE"
      grn "$key = $val"
      dim "Run 'novak up' to apply."
      ;;
    *) red "unknown: novak config $1"; exit 1 ;;
  esac
}

cmd_secret() {
  case "${1:-list}" in
    list)
      bold "Secrets   (macOS Keychain, account $(whoami))"
      echo
      local v
      for v in "${SECRET_VARS[@]}"; do
        if [ -n "$(keychain "$v")" ]; then printf '  %-30s %s\n' "$v" "$(grn present)"
        else printf '  %-30s %s\n' "$v" "$(red missing)"; fi
      done
      echo
      dim "  The login keychain is per-user — these are $(whoami)'s."
      ;;
    set)
      [ $# -ge 2 ] || { red "usage: novak secret set KEY [--generate]"; exit 1; }
      local key="$2"; shift 2
      is_secret "$key" || { ylw "'$key' isn't a known secret. Known:"; printf '  %s\n' "${SECRET_VARS[@]}"; exit 1; }

      local generate=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --generate) generate=1 ;;
          *) red "unknown option: $1"; exit 1 ;;
        esac
        shift
      done

      if [ "$generate" -eq 1 ]; then
        # Refuse, never warn. These must equal a value another system already
        # holds; a fresh random one here is not a shortcut, it is an outage
        # that looks like a permissions problem.
        if is_external "$key"; then
          red "$key belongs to another system — it cannot be generated."
          dim "  Its value must match what that system already has. Copy it from"
          dim "  there, then:  novak secret set $key"
          exit 1
        fi
        command -v openssl >/dev/null 2>&1 || { red "openssl not found — cannot generate."; exit 1; }
        security delete-generic-password -s "novak/$key" >/dev/null 2>&1 || true
        # Fed on stdin twice: `security -w` with no value prompts for the
        # password AND a confirmation, so a single line stores an empty item
        # and reports success. Verified — one line gives "passwords don't
        # match" and a zero-length secret.
        #
        # stdin rather than -w "$value" so the secret never appears in the
        # process list.
        local gen; gen="$(openssl rand -hex 32)"
        if ! printf '%s\n%s\n' "$gen" "$gen" |
             security add-generic-password -s "novak/$key" -a "$(whoami)" -w >/dev/null 2>&1; then
          red "Could not store the generated value in the Keychain."; exit 1
        fi
        # Trust nothing: confirm what came back is what went in, because the
        # failure mode above stored an empty value and still looked fine.
        if [ "$(keychain "$key")" != "$gen" ]; then
          red "$key did not store correctly — the Keychain returned a different value."
          exit 1
        fi
        unset gen
        grn "$key generated and stored. The value was not displayed."
      else
        security delete-generic-password -s "novak/$key" >/dev/null 2>&1 || true
        # -w with no argument prompts without echoing.
        security add-generic-password -s "novak/$key" -a "$(whoami)" -w
        grn "$key stored in the Keychain."
      fi

      if is_shared "$key"; then
        echo
        ylw "  $key is registered in clients as a bearer token."
        dim "  Open WebUI and Home Assistant each hold a copy of the OLD value and"
        dim "  will fail until re-registered. Read it back with:"
        dim "      novak secret show $key"
      fi
      dim "Run 'novak up' to apply."
      ;;
    show)
      [ $# -ge 2 ] || { red "usage: novak secret show KEY"; exit 1; }
      is_secret "$2" || { red "'$2' isn't a known secret."; exit 1; }
      local val; val="$(keychain "$2")"
      if [ -z "$val" ]; then
        red "$2 is not in the Keychain."
        # Suggesting --generate for an externally-owned secret would send the
        # reader straight into a refusal.
        if is_external "$2"; then dim "  Copy it from the system that owns it, then:  novak secret set $2"
        else dim "  novak secret set $2 --generate"; fi
        exit 1
      fi
      # Deliberately explicit: `list` and `config` never print values, so this
      # is the one place a secret reaches the terminal, and only when asked for
      # by name. Needed because a shared secret has to be pasted into a client.
      ylw "This prints a secret to your terminal."
      echo
      printf '%s\n' "$val"
      ;;
    *) red "unknown: novak secret $1"; exit 1 ;;
  esac
}

# Compares this deployment against the repo. Deliberately read-only and
# credential-free: it opens two files and prints the difference, so it is safe
# to run anywhere and cannot itself cause the drift it reports.
#
# The problem it exists for: up.sh seeds $NOVAK_HOME once and never overwrites
# it, because your config and your registry belong to you. The cost is that a
# repo-side change never reaches an existing install, and nothing says so. A
# deployment can run happily for months describing a system two migrations old
# — which is exactly what happened here with a registry that still listed
# Mem0-era entries and no Hindsight endpoints at all.
# Applies registry/omlx.yaml. Kept separate from `up` because it can restart
# oMLX, though only when something actually differs — see reconciler/omlx_apply.py.
cmd_omlx() {
  case "${1:-apply}" in
    apply)
      shift 2>/dev/null || true
      # The applier reads OMLX_API_KEY from the environment; it never reads the
      # Keychain itself, matching how up.sh resolves secrets.
      local key; key="$(keychain OMLX_API_KEY)"
      OMLX_API_KEY="$key" NOVAK_HOME="$NOVAK_HOME" \
        "$NOVAK_HOME/.venv/bin/python" "$REPO_DIR/reconciler/omlx_apply.py" "$@"
      ;;
    *) red "unknown: novak omlx $1"; dim "  novak omlx apply [--dry-run]"; exit 1 ;;
  esac
}

cmd_drift() {
  need_env
  bold "Drift   (this deployment vs the repo)"
  echo
  dim "  Read-only. Compares files only — client-side config (Open WebUI"
  dim "  presets, HA agent prompts) needs credentials and is not checked here."
  echo

  local found=0

  # ── settings ──────────────────────────────────────────────────────────
  local ex="$REPO_DIR/.env.example"
  if [ -f "$ex" ]; then
    local newkeys=() gonekeys=()
    local k
    while IFS= read -r k; do
      grep -qE "^${k}=" "$ENV_FILE" 2>/dev/null || newkeys+=("$k")
    done < <(grep -oE '^[A-Z_][A-Z0-9_]*=' "$ex" | tr -d '=')
    while IFS= read -r k; do
      grep -qE "^${k}=" "$ex" 2>/dev/null || gonekeys+=("$k")
    done < <(grep -oE '^[A-Z_][A-Z0-9_]*=' "$ENV_FILE" | tr -d '=')

    if [ ${#newkeys[@]} -gt 0 ]; then
      found=1
      ylw "  Settings the repo added since this was seeded:"
      printf '    %s\n' "${newkeys[@]}"
      dim  "    Defaults apply until set; add them to $ENV_FILE to change one."
      echo
    fi
    if [ ${#gonekeys[@]} -gt 0 ]; then
      found=1
      ylw "  Settings here that the repo no longer defines:"
      printf '    %s\n' "${gonekeys[@]}"
      dim  "    Usually harmless leftovers. Nothing reads them."
      echo
    fi
  fi

  # ── registry ──────────────────────────────────────────────────────────
  local dep="$NOVAK_HOME/registry/mcp-servers.yaml"
  local src="$REPO_DIR/registry/mcp-servers.yaml"
  if [ -f "$dep" ] && [ -f "$src" ]; then
    local added=() removed=()
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$dep" || added+=("$k")
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$src" | awk '{print $3}')
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$src" || removed+=("$k")
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$dep" | awk '{print $3}')

    if [ ${#added[@]} -gt 0 ]; then
      found=1
      ylw "  MCP servers the repo defines that this deployment does not have:"
      printf '    %s\n' "${added[@]}"
      dim  "    Nothing advertises these to clients until they are added."
      echo
    fi
    if [ ${#removed[@]} -gt 0 ]; then
      found=1
      ylw "  MCP servers here that the repo no longer defines:"
      printf '    %s\n' "${removed[@]}"
      dim  "    Often a superseded backend. Check before keeping."
      echo
    fi
    if [ ${#added[@]} -gt 0 ] || [ ${#removed[@]} -gt 0 ]; then
      dim "    To adopt the repo's list (your edits are overwritten, so back up):"
      dim "      cp $dep $dep.bak"
      dim "      cp $src $dep"
      echo
    fi
  elif [ ! -f "$dep" ]; then
    dim "  No deployed registry yet — 'novak up' seeds one."
    echo
  fi

  [ "$found" -eq 0 ] && grn "  No drift. Deployment matches the repo."
  return 0
}

cmd_ports() {
  need_env
  bold "Reachability"
  echo
  dim "  Probes each port by connecting, rather than inspecting sockets:"
  dim "  \`lsof\` only shows THIS user's processes without sudo, so a service"
  dim "  run by another account looks absent when it is merely invisible."
  echo

  # Ask the system daemon by its socket rather than letting the CLI choose.
  # On macOS the CLI prefers a per-user GUI app's local API when one is
  # running, and the sandboxed App Store build answers "NeedsLogin" even while
  # the system daemon underneath is up and holding the tailnet address. On a
  # headless install the daemon is always the one that matters.
  local ts_sock=/var/run/tailscaled.socket
  local ts
  if [ -S "$ts_sock" ]; then
    ts="$(tailscale --socket="$ts_sock" ip -4 2>/dev/null | head -1 || true)"
  else
    ts="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  fi
  printf '  %-22s %-7s %-12s %s\n' "SERVICE" "PORT" "LOCALHOST" "${ts:-TAILSCALE}"

  probe() { nc -z -w 2 "$1" "$2" >/dev/null 2>&1; }

  row() {
    local label="$1" port="$2" l t
    [ -n "$port" ] || return 0
    # Pad first, colour second — ANSI codes count toward printf's width.
    if probe 127.0.0.1 "$port"; then l="$(printf '\033[32m%-12s\033[0m' yes)"
    else l="$(printf '\033[31m%-12s\033[0m' no)"; fi
    if [ -z "$ts" ]; then t="?"
    elif probe "$ts" "$port"; then t="$(printf '\033[32m%s\033[0m' yes)"
    else t="$(printf '\033[31m%s\033[0m' no)"; fi
    printf '  %-22s %-7s %s %s\n' "$label" "$port" "$l" "$t"
  }

  row "oMLX (host app)"  "$(envval OMLX_PORT)"
  row "Console"          "$(envval CONSOLE_PORT)"
  row "Hindsight API"    "$(envval HINDSIGHT_PORT)"
  row "Hindsight UI"     "$(envval HINDSIGHT_UI_PORT)"
  row "Open WebUI"       "$(envval OPENWEBUI_PORT)"
  row "Whisper (STT)"    "$(envval WHISPER_PORT)"
  row "Piper (TTS)"      "$(envval PIPER_PORT)"

  echo
  dim "  localhost yes / tailscale no  -> bound to 127.0.0.1 only. For oMLX that"
  dim "     is its own admin-UI setting; HOST_NAME does not affect any binding."
  dim "  both no                       -> not running. Try: novak status, novak logs"
  echo
  if [ -z "$ts" ]; then ylw "  No Tailscale address — is it running and logged in?"; fi

  # Containers are per-user on macOS: each account runs its own OrbStack VM.
  # Seeing none here while services respond means they belong to another user.
  if docker info >/dev/null 2>&1; then
    local n; n="$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')"
    local owner; owner="$(ps -axo user,comm 2>/dev/null | awk '/OrbStack/ && !/awk/ {print $1; exit}')"
    echo "  Containers visible to $(whoami): $n"
    if [ "$n" = "0" ] && [ -n "$owner" ] && [ "$owner" != "$(whoami)" ]; then
      red "  OrbStack is running as '$owner', not $(whoami)."
      dim "  Each macOS account has its own OrbStack VM and socket, so the"
      dim "  containers started by that account are invisible here. Run the stack"
      dim "  from one account consistently — for a service install, that is $(whoami)."
    fi
  else
    ylw "  Docker is not responding — start OrbStack in THIS account."
  fi
}

cmd_status() {
  bold "Novak"
  echo "  repo    $REPO_DIR"
  echo "  config  $NOVAK_HOME"
  echo
  if [ ! -f "$ENV_FILE" ]; then ylw "  Not configured yet — run 'novak up' to seed config."; return; fi

  local unedited=() missing=()
  local edits=("${REQUIRED_EDITS[@]}")
  grep -qE '^\s*console:' "$REPO_DIR/docker-compose.yml" && edits+=("${CONSOLE_EDITS[@]}")
  local v val
  for v in "${edits[@]}"; do val="$(envval "$v")"; { [ -z "$val" ] || [[ "$val" =~ $PLACEHOLDERS ]]; } && unedited+=("$v"); done
  for v in "${CORE_SECRETS[@]}"; do [ -z "$(keychain "$v")" ] && missing+=("$v"); done

  if [ ${#unedited[@]} -eq 0 ] && [ ${#missing[@]} -eq 0 ]; then
    grn "  Config: ready"
  else
    [ ${#unedited[@]} -gt 0 ] && { red "  Needs editing:"; printf '    novak config set %s ...\n' "${unedited[@]}"; }
    [ ${#missing[@]} -gt 0 ] && { red "  Missing secrets:"; printf '    novak secret set %s\n' "${missing[@]}"; }
  fi

  # A one-line pointer, not the report. Drift is silent by nature — the stack
  # stays healthy while describing an older system — so status has to mention
  # it or nobody thinks to look.
  local drift_n=0 dep="$NOVAK_HOME/registry/mcp-servers.yaml" src="$REPO_DIR/registry/mcp-servers.yaml"
  if [ -f "$dep" ] && [ -f "$src" ]; then
    local k
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$dep" || drift_n=$((drift_n+1))
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$src" | awk '{print $3}')
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$src" || drift_n=$((drift_n+1))
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$dep" | awk '{print $3}')
  fi
  if [ "$drift_n" -gt 0 ]; then
    ylw "  Registry differs from the repo in $drift_n entr$([ "$drift_n" = 1 ] && echo y || echo ies) — novak drift"
  fi
  echo
  if docker info >/dev/null 2>&1; then
    bold "Containers"
    compose ps --format '  {{.Name}}\t{{.State}}\t{{.Status}}' 2>/dev/null | sed 's/\t/  /g' || dim "  none running"
  else
    ylw "  Docker isn't responding — is OrbStack running?"
  fi
}

compose() {
  # The console sits behind a compose profile so a missing OIDC secret cannot
  # stop the rest of the stack. Enable it here so `logs`, `restart`, `down` and
  # `ps` can still see a console that is already running — none of these create
  # containers, so this cannot start an unconfigured one. Only up.sh decides
  # that, and only when its config is complete.
  local args=(env COMPOSE_PROFILES=console docker compose --project-directory "$NOVAK_HOME" -f "$REPO_DIR/docker-compose.yml")
  [ -f "$ENV_FILE" ] && args+=(--env-file "$ENV_FILE")
  [ -f "$NOVAK_HOME/docker-compose.mcp.yml" ] && args+=(-f "$NOVAK_HOME/docker-compose.mcp.yml")
  "${args[@]}" "$@"
}

case "${1:-status}" in
  status)   cmd_status ;;
  ports)    cmd_ports ;;
  drift)    cmd_drift ;;
  omlx)     shift; cmd_omlx "$@" ;;
  doctor)   cmd_status ;;   # same checks up.sh runs, without starting anything
  config)   shift; cmd_config "$@" ;;
  secret)   shift; cmd_secret "$@" ;;
  up)       exec "$REPO_DIR/scripts/up.sh" ;;
  down)     compose down ;;
  restart)  shift; compose restart "$@" ;;
  logs)     shift; compose logs -f --tail=100 "$@" ;;
  registry) exec "$NOVAK_HOME/.venv/bin/python" "$REPO_DIR/reconciler/reconcile.py" --dry-run ;;
  -h|--help|help) usage ;;
  *) red "unknown command: $1"; echo; usage; exit 1 ;;
esac
