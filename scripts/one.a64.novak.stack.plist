<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>one.a64.novak.stack</string>

  <!-- A LaunchAgent, deliberately: agents run inside a login session, which is
       what oMLX and OrbStack need. A LaunchDaemon starts at boot with no
       window server and cannot run them. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <!-- bootstrap.sh substitutes the placeholder below with the real checkout
         path at install time, so this template is not usable by a bare `cp`.
         A hardcoded default is only ever correct on the machine it was written
         on, and when it is wrong the agent does not complain — it fails into
         the KeepAlive loop while containers stay up under their own restart
         policy. Re-run bootstrap.sh if the checkout moves. -->
    <string>exec "${NOVAK_REPO:-__NOVAK_REPO__}/scripts/launch-stack.sh"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Retry only on failure. up.sh exits 0 when the stack is up, so this does
       not loop; it does recover if Docker was still starting. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/tmp/novak-stack.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/novak-stack.err</string>
</dict>
</plist>
