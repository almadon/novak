#!/usr/bin/env bash
# novak — a small CLI for running and configuring the stack.
#
# Exists because "edit a file, remember which lines are placeholders, re-run a
# script" is a bad interface for something you touch every few weeks.
#
#   novak                     no args: an interactive menu covering everything
#                             below (novak menu, novak tui — same thing)
#   novak status              what's configured, what's running
#   novak ports               what's listening, and whether it's reachable
#   novak drift               where this deployment differs from the repo
#                             (aliases: verify, check)
#   novak drift --adopt       copy settings the repo added into your .env
#   novak adopt               git pull, then the above — refuses to pull over
#                             uncommitted changes or diverged history
#   novak doctor              check config without starting anything
#   novak config              list settings and where each value comes from
#   novak config get KEY
#   novak config set KEY VAL  edit .env in place, preserving comments
#   novak secret set KEY      store a secret in the Keychain (prompts, no echo)
#   novak secret set KEY --generate
#                             generate one and store it, never displaying it.
#                             Refused for secrets another system owns.
#   novak secret show KEY     print one, when a client needs it pasted in
#   novak secret list         which secrets are present (never their values)
#   novak secret verify       do they read back unattended, without a prompt?
#   novak up                  apply config and start
#   novak update [SERVICE...] pull new images and recreate what changed
#   novak down                stop, keep data
#   novak restart [SERVICE]
#   novak logs [SERVICE]
#   novak registry            show the MCP registry as the reconciler sees it
#   novak omlx apply          apply registry/omlx.yaml (models, profiles, TTLs)
#
# Add to PATH: bootstrap.sh does this, at ~/.local/bin/novak (see docs/cli.md
# for why not /usr/local/bin)
set -euo pipefail

# Same defensive PATH as scripts/launch-stack.sh. This is reached through a
# symlink in ~/.local/bin, so it runs under whatever environment the caller
# had — cron, a LaunchAgent, or a login shell that never sourced Homebrew.
# `tailscale` in particular lives only in /opt/homebrew/bin, and when it is
# absent `novak ports` reports no Tailscale address on a machine that is
# perfectly online — indistinguishable from the real thing.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.orbstack/bin:$PATH"

# Resolve symlinks before locating the repo. This script is meant to be linked
# into PATH, and BASH_SOURCE is then the LINK's path — computing the repo from
# it directly lands in /usr/local and nothing is found. `readlink -f` is not
# portable to older macOS, hence the loop.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINKDIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$LINKDIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export REPO_DIR

if [ ! -f "$REPO_DIR/scripts/lib/vars.sh" ]; then
  echo "✋ Could not locate the Novak checkout from $0" >&2
  echo "   Resolved to: $REPO_DIR" >&2
  echo "   If this is a symlink, re-create it pointing at scripts/novak in the" >&2
  echo "   checkout:  ln -sf /path/to/novak/scripts/novak ~/.local/bin/novak" >&2
  exit 1
fi
NOVAK_HOME="${NOVAK_HOME:-$HOME/.novak}"
ENV_FILE="$NOVAK_HOME/.env"
source "$REPO_DIR/scripts/lib/vars.sh"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
red()  { printf '\033[31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

need_env() {
  [ -f "$ENV_FILE" ] || { red "No config at $ENV_FILE — run 'novak up' once to seed it."; exit 1; }
}
is_secret()   { local v; for v in "${SECRET_VARS[@]}";     do [ "$v" = "$1" ] && return 0; done; return 1; }
is_external() { local v; for v in "${EXTERNAL_SECRETS[@]}"; do [ "$v" = "$1" ] && return 0; done; return 1; }
is_shared()   { local v; for v in "${SHARED_SECRETS[@]}";   do [ "$v" = "$1" ] && return 0; done; return 1; }
# Where a secret has to be repeated by hand, so rotating one says what it breaks.
secret_kind() {
  if is_external "$1"; then echo "external"
  elif is_shared "$1"; then echo "shared"
  else echo "internal"; fi
}
envval()    { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true ; }
keychain()  { security find-generic-password -s "novak/${1}" -w 2>/dev/null || true; }

cmd_config() {
  need_env
  case "${1:-list}" in
    list)
      bold "Settings   ($ENV_FILE)"
      echo
      printf '  %-30s %-10s %s\n' "SETTING" "SOURCE" "STATUS"
      local key val
      while IFS='=' read -r key val; do
        [[ "$key" =~ ^[A-Z] ]] || continue
        if is_secret "$key"; then
          if [ -n "$(keychain "$key")" ]; then
            printf '  %-30s %-10s %s\n' "$key" "keychain" "$(grn set)"
          else
            printf '  %-30s %-10s %s\n' "$key" "keychain" "$(red MISSING)"
          fi
        elif [[ "$val" =~ $PLACEHOLDERS ]]; then
          printf '  %-30s %-10s %s\n' "$key" ".env" "$(red 'NEEDS EDITING')"
        else
          printf '  %-30s %-10s %s\n' "$key" ".env" "$val"
        fi
      done < <(grep -E '^[A-Z_]+=' "$ENV_FILE")
      echo
      dim "  Secret values are never printed. 'novak secret set KEY' to change one."
      ;;
    get) [ $# -ge 2 ] || { red "usage: novak config get KEY"; exit 1; }
         is_secret "$2" && { red "$2 is a secret — values are not printed. Try 'novak secret list'."; exit 1; }
         envval "$2" ;;
    set)
      [ $# -ge 3 ] || { red "usage: novak config set KEY VALUE"; exit 1; }
      local key="$2"; shift 2; local val="$*"
      is_secret "$key" && { red "$key is a secret. Use: novak secret set $key"; exit 1; }
      grep -qE "^${key}=" "$ENV_FILE" || { red "Unknown setting '$key'. 'novak config' lists them."; exit 1; }
      # In-place, comment-preserving. The delimiter avoids clashing with URLs.
      local tmp; tmp="$(mktemp)"
      awk -v k="$key" -v v="$val" '
        $0 ~ "^" k "=" && !done { print k "=" v; done=1; next } { print }
      ' "$ENV_FILE" > "$tmp" && mv "$tmp" "$ENV_FILE"
      grn "$key = $val"
      dim "Run 'novak up' to apply."
      ;;
    *) red "unknown: novak config $1"; exit 1 ;;
  esac
}

cmd_secret() {
  case "${1:-list}" in
    list)
      bold "Secrets   (macOS Keychain, account $(whoami))"
      echo
      local v
      for v in "${SECRET_VARS[@]}"; do
        if [ -n "$(keychain "$v")" ]; then printf '  %-30s %s\n' "$v" "$(grn present)"
        else printf '  %-30s %s\n' "$v" "$(red missing)"; fi
      done
      echo
      dim "  The login keychain is per-user — these are $(whoami)'s."
      ;;
    set)
      [ $# -ge 2 ] || { red "usage: novak secret set KEY [--generate]"; exit 1; }
      local key="$2"; shift 2
      is_secret "$key" || { ylw "'$key' isn't a known secret. Known:"; printf '  %s\n' "${SECRET_VARS[@]}"; exit 1; }

      local generate=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --generate) generate=1 ;;
          *) red "unknown option: $1"; exit 1 ;;
        esac
        shift
      done

      if [ "$generate" -eq 1 ]; then
        # Refuse, never warn. These must equal a value another system already
        # holds; a fresh random one here is not a shortcut, it is an outage
        # that looks like a permissions problem.
        if is_external "$key"; then
          red "$key belongs to another system — it cannot be generated."
          dim "  Its value must match what that system already has. Copy it from"
          dim "  there, then:  novak secret set $key"
          exit 1
        fi
        command -v openssl >/dev/null 2>&1 || { red "openssl not found — cannot generate."; exit 1; }
        security delete-generic-password -s "novak/$key" >/dev/null 2>&1 || true
        # Fed on stdin twice: `security -w` with no value prompts for the
        # password AND a confirmation, so a single line stores an empty item
        # and reports success. Verified — one line gives "passwords don't
        # match" and a zero-length secret.
        #
        # stdin rather than -w "$value" so the secret never appears in the
        # process list.
        local gen; gen="$(openssl rand -hex 32)"
        if ! printf '%s\n%s\n' "$gen" "$gen" |
             security add-generic-password -s "novak/$key" -a "$(whoami)" \
               -T /usr/bin/security -w >/dev/null 2>&1; then
          red "Could not store the generated value in the Keychain."; exit 1
        fi
        # Trust nothing: confirm what came back is what went in, because the
        # failure mode above stored an empty value and still looked fine.
        if [ "$(keychain "$key")" != "$gen" ]; then
          red "$key did not store correctly — the Keychain returned a different value."
          exit 1
        fi
        unset gen
        grn "$key generated and stored. The value was not displayed."
      else
        security delete-generic-password -s "novak/$key" >/dev/null 2>&1 || true
        # -w with no argument prompts without echoing.
        # -T /usr/bin/security pre-authorises the tool that reads this back.
        # Without it macOS raises a GUI authorisation dialog on first read,
        # which on an unattended boot hangs rather than failing — the stack
        # simply never starts. See `novak secret verify`.
        security add-generic-password -s "novak/$key" -a "$(whoami)" \
          -T /usr/bin/security -w
        grn "$key stored in the Keychain."
      fi

      if is_shared "$key"; then
        echo
        ylw "  $key is registered in clients as a bearer token."
        dim "  Open WebUI and Home Assistant each hold a copy of the OLD value and"
        dim "  will fail until re-registered. Read it back with:"
        dim "      novak secret show $key"
      fi
      dim "Run 'novak up' to apply."
      ;;
    show)
      [ $# -ge 2 ] || { red "usage: novak secret show KEY"; exit 1; }
      is_secret "$2" || { red "'$2' isn't a known secret."; exit 1; }
      local val; val="$(keychain "$2")"
      if [ -z "$val" ]; then
        red "$2 is not in the Keychain."
        # Suggesting --generate for an externally-owned secret would send the
        # reader straight into a refusal.
        if is_external "$2"; then dim "  Copy it from the system that owns it, then:  novak secret set $2"
        else dim "  novak secret set $2 --generate"; fi
        exit 1
      fi
      # Deliberately explicit: `list` and `config` never print values, so this
      # is the one place a secret reaches the terminal, and only when asked for
      # by name. Needed because a shared secret has to be pasted into a client.
      ylw "This prints a secret to your terminal."
      echo
      printf '%s\n' "$val"
      ;;
    verify)
      bold "Unattended readability"
      echo
      dim "  Reads each secret the way up.sh does, with a timeout. A hang means"
      dim "  macOS wants an authorisation dialog — which on a headless boot"
      dim "  nothing will ever click, so the stack waits forever instead of"
      dim "  failing."
      echo
      local v out rc failed=0
      for v in "${SECRET_VARS[@]}"; do
        # Capture status separately: `if x="$(...)"; rc=$?; then` tests the
        # assignment, which always succeeds, and reports everything as fine.
        out="$(perl -e 'alarm 5; exec @ARGV' security find-generic-password \
                -s "novak/$v" -w 2>/dev/null)" && rc=0 || rc=$?
        if [ "$rc" -eq 0 ] && [ -n "$out" ]; then
          printf '  %-30s %s\n' "$v" "$(grn 'reads cleanly')"
        elif [ "$rc" -eq 142 ] || [ "$rc" -eq 14 ]; then
          printf '  %-30s %s\n' "$v" "$(red 'HANGS — would block boot')"; failed=1
        else
          printf '  %-30s %s\n' "$v" "$(dim 'not set')"
        fi
      done
      unset out
      echo
      if [ "$failed" -eq 1 ]; then
        red "  Re-add the hanging items with 'novak secret set <NAME>' — this CLI"
        red "  pre-authorises the reader; a hand-run 'security' call does not."
      else
        dim "  This proves nothing about a LOCKED keychain. The login keychain"
        dim "  unlocks when this account logs in, so unattended boot depends on"
        dim "  the session starting at all — see docs/headless-operation.md."
      fi
      ;;
    *) red "unknown: novak secret $1"; exit 1 ;;
  esac
}

# Compares this deployment against the repo. Deliberately read-only and
# credential-free: it opens two files and prints the difference, so it is safe
# to run anywhere and cannot itself cause the drift it reports.
#
# The problem it exists for: up.sh seeds $NOVAK_HOME once and never overwrites
# it, because your config and your registry belong to you. The cost is that a
# repo-side change never reaches an existing install, and nothing says so. A
# deployment can run happily for months describing a system two migrations old
# — which is exactly what happened here with a registry that still listed
# Mem0-era entries and no Hindsight endpoints at all.
# Applies registry/omlx.yaml. Kept separate from `up` because it can restart
# oMLX, though only when something actually differs — see reconciler/omlx_apply.py.
cmd_omlx() {
  case "${1:-apply}" in
    apply)
      shift 2>/dev/null || true
      # The applier reads OMLX_API_KEY from the environment; it never reads the
      # Keychain itself, matching how up.sh resolves secrets.
      local key; key="$(keychain OMLX_API_KEY)"
      OMLX_API_KEY="$key" NOVAK_HOME="$NOVAK_HOME" \
        "$NOVAK_HOME/.venv/bin/python" "$REPO_DIR/reconciler/omlx_apply.py" "$@"
      ;;
    *) red "unknown: novak omlx $1"; dim "  novak omlx apply [--dry-run]"; exit 1 ;;
  esac
}

# Copies settings the repo has added into this deployment's .env, with the
# comments that explain them, never touching a value already set.
#
# Exists because `novak config set` only accepts keys already present in .env —
# so a setting the repo added is unreachable until the file gains the line, and
# hand-editing .env is exactly the interface this CLI was written to replace.
drift_adopt() {
  local ex="$REPO_DIR/.env.example"
  [ -f "$ex" ] || { red "No .env.example to adopt from."; exit 1; }

  local backup="$ENV_FILE.bak-$(date +%Y%m%d-%H%M%S)"
  cp "$ENV_FILE" "$backup"

  local added
  added="$(python3 - "$ex" "$ENV_FILE" <<'PYEOF'
import re, sys
example, envfile = sys.argv[1], sys.argv[2]
have = {l.split("=", 1)[0].strip()
        for l in open(envfile) if re.match(r"^[A-Z_][A-Z0-9_]*=", l)}

lines = open(example).read().splitlines()
block, out, added = [], [], []
for line in lines:
    m = re.match(r"^([A-Z_][A-Z0-9_]*)=", line)
    if not m:
        # Blank lines end a comment block; comments accumulate into one.
        block = [] if not line.strip() else block + [line]
        continue
    key = m.group(1)
    if key not in have:
        if block:
            out += block
        out.append(line)
        added.append(key)
    block = []

if out:
    with open(envfile, "a") as f:
        f.write("\n# ── Added by 'novak drift --adopt' ──────────────────────────\n")
        f.write("\n".join(out) + "\n")
print(" ".join(added))
PYEOF
)"

  if [ -z "$added" ]; then
    rm -f "$backup"
    grn "  Nothing to adopt — every setting the repo defines is already here."
    return 0
  fi
  grn "  Added to $ENV_FILE:"
  printf '    %s\n' $added
  echo
  dim "  Values are the repo's defaults, with their comments. Backup: $backup"
  dim "  Set one with:  novak config set <KEY> <value>"
  dim "  Secrets among them still need:  novak secret set <KEY>"
}

# `novak drift --adopt` (above) merges the .env schema only, deliberately —
# some people want that without touching git. This is the other thing:
# pull the checkout, then run the same merge, in one command. Requested
# directly after `novak config set OWUI_INFERENCE_PORT 4000` failed with
# "Unknown setting" on a deployment that had pulled the repo but never
# adopted the schema — two steps that are really one for most people, so
# now there's a command that's actually one.
cmd_adopt() {
  need_env
  bold "Adopt"
  echo

  if [ ! -d "$REPO_DIR/.git" ]; then
    red "  $REPO_DIR is not a git checkout — cannot pull."
    exit 1
  fi

  # Refuses rather than stashes or discards: the service account's checkout
  # is also where this session builds and branches from, not a pristine
  # deploy-only clone, so "uncommitted changes" here can be real work in
  # progress, not stray drift. Same instinct as security.md's "read before
  # you overwrite" — an operation that could silently lose something does
  # not get to guess that it's fine.
  if [ -n "$(git -C "$REPO_DIR" status --porcelain)" ]; then
    red "  $REPO_DIR has uncommitted changes — not pulling."
    dim "  Commit, stash, or discard them first, then run this again."
    exit 1
  fi

  local branch
  branch="$(git -C "$REPO_DIR" branch --show-current)"
  if [ -z "$branch" ]; then
    red "  $REPO_DIR is on a detached HEAD — not pulling."
    dim "  Check out a real branch first."
    exit 1
  fi

  bold "Pulling $branch"
  # --ff-only, not a plain pull: refuses outright rather than creating a
  # merge commit or silently rebasing when local and remote history have
  # diverged. A failure here should look like a failure, not like it
  # quietly did something you'd want to review first.
  if ! git -C "$REPO_DIR" pull --ff-only; then
    echo
    red "  Pull failed — see the git output above. Common causes: no"
    red "  tracking branch set (a local branch that's never been pushed),"
    red "  or history that's diverged from the remote. This resolves"
    red "  neither for you — set an upstream or fix the divergence by hand."
    exit 1
  fi
  echo

  bold "Adopting settings the repo has added"
  echo
  drift_adopt

  echo
  dim "Run 'novak up' to apply any of this."
}

cmd_drift() {
  need_env
  if [ "${1:-}" = "--adopt" ]; then
    bold "Adopting settings the repo has added"
    echo
    drift_adopt
    return 0
  fi
  bold "Drift   (this deployment vs the repo)"
  echo
  dim "  Read-only. Compares files only — client-side config (Open WebUI"
  dim "  presets, HA agent prompts) needs credentials and is not checked here."
  echo

  local found=0

  # ── settings ──────────────────────────────────────────────────────────
  local ex="$REPO_DIR/.env.example"
  if [ -f "$ex" ]; then
    local newkeys=() gonekeys=()
    local k
    while IFS= read -r k; do
      grep -qE "^${k}=" "$ENV_FILE" 2>/dev/null || newkeys+=("$k")
    done < <(grep -oE '^[A-Z_][A-Z0-9_]*=' "$ex" | tr -d '=')
    while IFS= read -r k; do
      grep -qE "^${k}=" "$ex" 2>/dev/null || gonekeys+=("$k")
    done < <(grep -oE '^[A-Z_][A-Z0-9_]*=' "$ENV_FILE" | tr -d '=')

    if [ ${#newkeys[@]} -gt 0 ]; then
      found=1
      ylw "  Settings the repo added since this was seeded:"
      printf '    %s\n' "${newkeys[@]}"
      dim  "    Defaults apply until set; add them to $ENV_FILE to change one."
      echo
    fi
    if [ ${#gonekeys[@]} -gt 0 ]; then
      found=1
      ylw "  Settings here that the repo no longer defines:"
      printf '    %s\n' "${gonekeys[@]}"
      dim  "    Usually harmless leftovers. Nothing reads them."
      echo
    fi
  fi

  # ── registry ──────────────────────────────────────────────────────────
  local dep="$NOVAK_HOME/registry/mcp-servers.yaml"
  local src="$REPO_DIR/registry/mcp-servers.yaml"
  if [ -f "$dep" ] && [ -f "$src" ]; then
    local added=() removed=()
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$dep" || added+=("$k")
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$src" | awk '{print $3}')
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$src" || removed+=("$k")
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$dep" | awk '{print $3}')

    if [ ${#added[@]} -gt 0 ]; then
      found=1
      ylw "  MCP servers the repo defines that this deployment does not have:"
      printf '    %s\n' "${added[@]}"
      dim  "    Nothing advertises these to clients until they are added."
      echo
    fi
    if [ ${#removed[@]} -gt 0 ]; then
      found=1
      ylw "  MCP servers here that the repo no longer defines:"
      printf '    %s\n' "${removed[@]}"
      dim  "    Often a superseded backend. Check before keeping."
      echo
    fi
    if [ ${#added[@]} -gt 0 ] || [ ${#removed[@]} -gt 0 ]; then
      dim "    To adopt the repo's list (your edits are overwritten, so back up):"
      dim "      cp $dep $dep.bak"
      dim "      cp $src $dep"
      echo
    fi
  elif [ ! -f "$dep" ]; then
    dim "  No deployed registry yet — 'novak up' seeds one."
    echo
  fi

  [ "$found" -eq 0 ] && grn "  No drift. Deployment matches the repo."
  return 0
}

cmd_ports() {
  need_env
  bold "Reachability"
  echo
  dim "  Probes each port by connecting, rather than inspecting sockets:"
  dim "  \`lsof\` only shows THIS user's processes without sudo, so a service"
  dim "  run by another account looks absent when it is merely invisible."
  echo

  # Ask the system daemon by its socket rather than letting the CLI choose.
  # On macOS the CLI prefers a per-user GUI app's local API when one is
  # running, and the sandboxed App Store build answers "NeedsLogin" even while
  # the system daemon underneath is up and holding the tailnet address. On a
  # headless install the daemon is always the one that matters.
  local ts_sock=/var/run/tailscaled.socket
  local ts
  if [ -S "$ts_sock" ]; then
    ts="$(tailscale --socket="$ts_sock" ip -4 2>/dev/null | head -1 || true)"
  else
    ts="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  fi
  printf '  %-22s %-7s %-12s %s\n' "SERVICE" "PORT" "LOCALHOST" "${ts:-TAILSCALE}"

  probe() { nc -z -w 2 "$1" "$2" >/dev/null 2>&1; }

  row() {
    local label="$1" port="$2" l t
    [ -n "$port" ] || return 0
    # Pad first, colour second — ANSI codes count toward printf's width.
    if probe 127.0.0.1 "$port"; then l="$(printf '\033[32m%-12s\033[0m' yes)"
    else l="$(printf '\033[31m%-12s\033[0m' no)"; fi
    if [ -z "$ts" ]; then t="?"
    elif probe "$ts" "$port"; then t="$(printf '\033[32m%s\033[0m' yes)"
    else t="$(printf '\033[31m%s\033[0m' no)"; fi
    printf '  %-22s %-7s %s %s\n' "$label" "$port" "$l" "$t"
  }

  row "oMLX (host app)"  "$(envval OMLX_PORT)"
  row "Router"           "$(envval ROUTER_PORT)"
  row "Console"          "$(envval CONSOLE_PORT)"
  row "Hindsight API"    "$(envval HINDSIGHT_PORT)"
  row "Hindsight UI"     "$(envval HINDSIGHT_UI_PORT)"
  row "Open WebUI"       "$(envval OPENWEBUI_PORT)"
  row "Whisper (STT)"    "$(envval WHISPER_PORT)"
  row "Piper (TTS)"      "$(envval PIPER_PORT)"

  echo
  dim "  localhost yes / tailscale no  -> bound to 127.0.0.1 only. For oMLX that"
  dim "     is its own admin-UI setting; HOST_NAME does not affect any binding."
  dim "  both no                       -> not running. Try: novak status, novak logs"
  echo
  if [ -z "$ts" ]; then ylw "  No Tailscale address — is it running and logged in?"; fi

  # Containers are per-user on macOS: each account runs its own OrbStack VM.
  # Seeing none here while services respond means they belong to another user.
  if docker info >/dev/null 2>&1; then
    local n; n="$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')"
    local owner; owner="$(ps -axo user,comm 2>/dev/null | awk '/OrbStack/ && !/awk/ {print $1; exit}')"
    echo "  Containers visible to $(whoami): $n"
    if [ "$n" = "0" ] && [ -n "$owner" ] && [ "$owner" != "$(whoami)" ]; then
      red "  OrbStack is running as '$owner', not $(whoami)."
      dim "  Each macOS account has its own OrbStack VM and socket, so the"
      dim "  containers started by that account are invisible here. Run the stack"
      dim "  from one account consistently — for a service install, that is $(whoami)."
    fi
  else
    ylw "  Docker is not responding — start OrbStack in THIS account."
  fi
}

cmd_update() {
  need_env
  if ! docker info >/dev/null 2>&1; then
    red "Docker isn't responding — is OrbStack running?"
    exit 1
  fi
  # Every image in docker-compose.yml is unpinned (:latest, :main) on purpose
  # for now — see docs/credits.md. `up.sh` never pulls, so a new release
  # sitting on the registry doesn't reach a running stack until something
  # calls `docker compose pull`. This is that something.
  bold "Pulling images"
  compose pull "$@" || { red "pull failed — see above."; exit 1; }
  echo
  # Recreate through up.sh rather than `compose up -d` directly: it also
  # re-applies the MCP registry and the oMLX profiles, so a newer app image
  # never ends up running against a stale registry from before the pull.
  # `docker compose up -d` only recreates containers whose image or config
  # actually changed, so this is a no-op for anything that didn't get a new
  # image above.
  bold "Recreating anything that changed"
  exec "$REPO_DIR/scripts/up.sh"
}

cmd_status() {
  bold "Novak"
  echo "  repo    $REPO_DIR"
  echo "  config  $NOVAK_HOME"
  echo
  if [ ! -f "$ENV_FILE" ]; then ylw "  Not configured yet — run 'novak up' to seed config."; return; fi

  local unedited=() missing=()
  local edits=("${REQUIRED_EDITS[@]}")
  grep -qE '^\s*console:' "$REPO_DIR/docker-compose.yml" && edits+=("${CONSOLE_EDITS[@]}")
  local v val
  for v in "${edits[@]}"; do val="$(envval "$v")"; { [ -z "$val" ] || [[ "$val" =~ $PLACEHOLDERS ]]; } && unedited+=("$v"); done
  for v in "${CORE_SECRETS[@]}"; do [ -z "$(keychain "$v")" ] && missing+=("$v"); done

  if [ ${#unedited[@]} -eq 0 ] && [ ${#missing[@]} -eq 0 ]; then
    grn "  Config: ready"
  else
    [ ${#unedited[@]} -gt 0 ] && { red "  Needs editing:"; printf '    novak config set %s ...\n' "${unedited[@]}"; }
    [ ${#missing[@]} -gt 0 ] && { red "  Missing secrets:"; printf '    novak secret set %s\n' "${missing[@]}"; }
  fi

  # A one-line pointer, not the report. Drift is silent by nature — the stack
  # stays healthy while describing an older system — so status has to mention
  # it or nobody thinks to look.
  local drift_n=0 dep="$NOVAK_HOME/registry/mcp-servers.yaml" src="$REPO_DIR/registry/mcp-servers.yaml"
  if [ -f "$dep" ] && [ -f "$src" ]; then
    local k
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$dep" || drift_n=$((drift_n+1))
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$src" | awk '{print $3}')
    while IFS= read -r k; do
      grep -qE "^  - name: ${k}\$" "$src" || drift_n=$((drift_n+1))
    done < <(grep -oE '^  - name: [a-z0-9-]+' "$dep" | awk '{print $3}')
  fi
  if [ "$drift_n" -gt 0 ]; then
    ylw "  Registry differs from the repo in $drift_n entr$([ "$drift_n" = 1 ] && echo y || echo ies) — novak drift"
  fi
  echo
  if docker info >/dev/null 2>&1; then
    bold "Containers"
    compose ps --format '  {{.Name}}\t{{.State}}\t{{.Status}}' 2>/dev/null | sed 's/\t/  /g' || dim "  none running"
  else
    ylw "  Docker isn't responding — is OrbStack running?"
  fi
}

compose() {
  # Every optional service sits behind a compose profile so a missing
  # secret cannot stop the rest of the stack. All three enabled here so
  # `logs`, `restart`, `down` and `ps` can still see whichever of them is
  # already running — none of these create containers, so this cannot
  # start an unconfigured one. Only up.sh decides that, and only when a
  # given profile's config is actually complete.
  local args=(env COMPOSE_PROFILES=console,portal,router docker compose --project-directory "$NOVAK_HOME" -f "$REPO_DIR/docker-compose.yml")
  [ -f "$ENV_FILE" ] && args+=(--env-file "$ENV_FILE")
  [ -f "$NOVAK_HOME/docker-compose.mcp.yml" ] && args+=(-f "$NOVAK_HOME/docker-compose.mcp.yml")
  "${args[@]}" "$@"
}

##############################################################################
# TUI — the menu shown when novak is run with no arguments.
#
# No new dependency for this. gum (charmbracelet/gum) was the obvious tool
# and was tried first — MIT, actively maintained, exactly the "menu in a
# shell script" problem already solved. Installing it here failed: this
# account has no write access to /opt/homebrew, the same class of problem
# bootstrap.sh's own CLI-symlink and LaunchAgent fixes exist to avoid, and
# adding a brew-installed binary as a hard dependency of the CLI's DEFAULT
# invocation would reintroduce it for every fresh deployment. Plain bash
# `select` needs nothing extra and already ships with the account.
##############################################################################

# No `|| true`: a failed read here means stdin is closed (input piped in
# ran out, Ctrl-D, EOF), and the caller needs to see that as a real failure
# to exit the menu loop instead of looping forever with nothing left to
# read. See cmd_menu's own comment on the read-vs-select bug this replaced.
tui_pause() { echo; read -rp "Press Enter to continue... " _; }

# Re-invokes this same script as a fresh process rather than calling a cmd_*
# function directly. Every cmd_* here is written as a top-level command and
# ends failure paths with `exit`, which is correct for a one-shot CLI call
# and wrong for a subroutine inside a menu loop: `exit` always ends the
# whole process, so a single failed action would silently kill the entire
# TUI session rather than just that one step. A child process contains it.
tui_run() { "$REPO_DIR/scripts/novak" "$@"; }

# Both exit(0) outright on closed stdin (EOF: input piped in ran out,
# Ctrl-D) rather than let `read`'s failure fall through to `set -e` and
# kill the script with no explanation partway through a guided flow. If
# there is genuinely nothing left to read, ending here is correct — it
# just says so first, and does it as a deliberate exit rather than an
# errexit crash the person watching didn't get an explanation for.
tui_eof() { echo; ylw "No more input — exiting."; exit 0; }

tui_ask() {
  # $1 prompt, optional $2 default. Prints the answer; empty input keeps the
  # default when one was given, or comes back empty when it wasn't.
  #
  # Every call site captures this via $(...), a subshell — `exit` here ends
  # only that subshell, not the real script, and anything printed before it
  # would be captured as part of the answer. So on EOF this exits silently
  # rather than reusing tui_eof: the caller gets an empty string, exactly
  # as if Enter had been pressed with no default, and the guided flow runs
  # out naturally rather than corrupting a setting with an error message.
  # cmd_menu's own top-level read is what actually ends the session once
  # control returns there with stdin still closed.
  local prompt="$1" default="${2:-}" ans
  if [ -n "$default" ]; then
    read -rp "$prompt [$default]: " ans || exit 0
    printf '%s\n' "${ans:-$default}"
  else
    read -rp "$prompt: " ans || exit 0
    printf '%s\n' "$ans"
  fi
}

tui_yn() {
  local ans
  read -rp "$1 [y/N]: " ans || tui_eof
  case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# Prompts for every REQUIRED_EDIT/CORE_SECRET that novak status would flag,
# then offers the console and portal as separate opt-in passes — each is a
# real question ("configure this now?"), not assumed from presence in the
# menu. Reuses cmd_config/cmd_secret via tui_run rather than duplicating
# their validation, generation, or Keychain handling.
cmd_guided_setup() {
  need_env
  bold "Guided setup"
  dim "  Asks for what 'novak status' would otherwise just list as missing."
  echo

  local ex="$REPO_DIR/.env.example"
  local newkeys=()
  if [ -f "$ex" ]; then
    local k
    while IFS= read -r k; do
      grep -qE "^${k}=" "$ENV_FILE" 2>/dev/null || newkeys+=("$k")
    done < <(grep -oE '^[A-Z_][A-Z0-9_]*=' "$ex" | tr -d '=')
  fi
  if [ ${#newkeys[@]} -gt 0 ]; then
    ylw "  The repo has settings this deployment's .env doesn't yet have:"
    printf '    %s\n' "${newkeys[@]}"
    if tui_yn "  Adopt them now (existing .env is backed up first)"; then
      tui_run drift --adopt
    else
      dim "  Skipping — anything below that needs one of those lines will"
      dim "  report 'Unknown setting' instead of prompting for it."
    fi
    echo
  fi

  local v val
  for v in "${REQUIRED_EDITS[@]}"; do
    val="$(envval "$v")"
    if [ -z "$val" ] || [[ "$val" =~ $PLACEHOLDERS ]]; then
      local new; new="$(tui_ask "Enter $v")"
      [ -n "$new" ] && tui_run config set "$v" "$new"
    fi
  done

  for v in "${CORE_SECRETS[@]}"; do
    if [ -z "$(keychain "$v")" ]; then
      echo
      bold "$v"
      dim "  Required — up.sh refuses to start the stack without it."
      if is_external "$v"; then
        dim "  Owned by another system; the value must match what it already has."
        tui_run secret set "$v"
      elif tui_yn "  Generate one automatically"; then
        tui_run secret set "$v" --generate
      else
        tui_run secret set "$v"
      fi
    fi
  done

  echo
  if grep -qE '^\s*console:' "$REPO_DIR/docker-compose.yml" 2>/dev/null \
     && tui_yn "Configure the optional console now"; then
    for v in "${CONSOLE_EDITS[@]}"; do
      val="$(envval "$v")"
      if [ -z "$val" ] || [[ "$val" =~ $PLACEHOLDERS ]]; then
        local new; new="$(tui_ask "Enter $v")"
        [ -n "$new" ] && tui_run config set "$v" "$new"
      fi
    done
    for v in "${CONSOLE_SECRETS[@]}"; do
      [ -z "$(keychain "$v")" ] && tui_run secret set "$v"
    done
  fi

  echo
  if tui_yn "Configure the optional portal now (Caddy + TinyAuth)"; then
    dim "  PORTAL_APPURL must be a real hostname with a scheme — never an IP."
    dim "  See docs/proxy.md if you haven't registered TinyAuth's Pocket ID"
    dim "  client yet; this only collects values, it doesn't create the client."
    for v in "${PORTAL_EDITS[@]}"; do
      val="$(envval "$v")"
      if [ -z "$val" ] || [[ "$val" =~ $PLACEHOLDERS ]]; then
        local new; new="$(tui_ask "Enter $v")"
        [ -n "$new" ] && tui_run config set "$v" "$new"
      fi
    done
    for v in "${PORTAL_SECRETS[@]}"; do
      [ -z "$(keychain "$v")" ] && tui_run secret set "$v"
    done
  fi

  echo
  grn "Guided setup done."
  tui_run status
}

# A phase-by-phase walk through deploy-checklist.md. Where a step is
# something this CLI can actually check (a file, a running process, a
# reachable port) it runs that check and reports pass/fail. Where the step
# is inherently manual — clicking through Pocket ID's own UI, downloading a
# model file — it prints the instruction and waits for you to confirm you
# did it. Nothing here is persisted between runs; it's a guided read-through
# with real checks where checks are possible, not a saved checklist.
cmd_checklist() {
  bold "Deployment checklist"
  dim "  Full detail in docs/deploy-checklist.md. This runs what can be"
  dim "  checked automatically and asks about what can't."
  echo

  bold "Phase 1 — Admin setup"
  if sudo -n fdesetup list 2>/dev/null | grep -q "^$(whoami),"; then
    grn "  novak can unlock FileVault at boot"
  else
    ylw "  Could not confirm — run manually: sudo fdesetup list"
  fi
  if pmset -g 2>/dev/null | grep -qE "autorestart\s*1"; then
    grn "  autorestart is on"
  else
    red "  autorestart is off — the Mac won't power back on after an outage"
  fi
  tui_pause

  bold "Phase 2 — The novak account and CLI"
  if command -v novak >/dev/null 2>&1; then
    grn "  novak resolves on PATH: $(command -v novak)"
  else
    red "  novak is not on PATH — see docs/cli.md"
  fi
  if docker info >/dev/null 2>&1; then
    grn "  Docker is responding in this account"
  else
    red "  Docker isn't responding — is OrbStack running as $(whoami)?"
  fi
  tui_pause

  bold "Phase 3 — Configuration"
  tui_run status
  tui_pause

  bold "Phase 4 — The model"
  # Two things this got wrong on the first pass, both real: curl's own exit
  # status only reflects connection-level failure, not an HTTP error body —
  # a 401 for a missing key still looks like success without -f/--fail — and
  # `grep -o '"id"' | ...` under this script's `set -o pipefail` exits 1 on
  # a legitimate zero-match response (no models loaded, or unauthorized),
  # which killed the ENTIRE script here, not just this one check. Both
  # reproduced directly against the running oMLX before being fixed.
  local omlx_port omlx_key omlx_body
  omlx_port="$(envval OMLX_PORT)"
  omlx_key="$(keychain OMLX_API_KEY)"
  if [ -n "$omlx_port" ]; then
    omlx_body="$(curl -sf --max-time 3 \
      ${omlx_key:+-H "Authorization: Bearer $omlx_key"} \
      "http://127.0.0.1:${omlx_port}/v1/models" 2>/dev/null || true)"
    if [ -z "$omlx_body" ]; then
      ylw "  Could not reach oMLX on port ${omlx_port}, or the request was refused"
      dim "  (missing/incorrect OMLX_API_KEY is the usual reason once it's running)"
    else
      local model_count
      # `grep -o | wc -l` is the right count; the `|| true` on grep alone,
      # inside its own group, is what's needed — pipefail cares about EVERY
      # stage, and grep exits 1 on a legitimate zero-match line, which would
      # otherwise fail the whole assignment before wc -l ever runs.
      model_count="$({ grep -o '"id"' <<<"$omlx_body" || true; } | wc -l | tr -d ' ')"
      if [ "${model_count:-0}" -gt 0 ]; then
        grn "  oMLX is serving ${model_count} model(s)"
      else
        red "  oMLX answered but /v1/models looks empty — no model loaded"
      fi
    fi
  else
    ylw "  OMLX_PORT is not set — skipping"
  fi
  tui_yn "Have you set personas per client from prompts/ (decision #18 — no automation does this yet)" \
    && grn "  noted" || dim "  reminder: still manual, see docs/STATE.md"
  tui_pause

  bold "Phase 5 — Start it"
  tui_run status
  tui_pause

  bold "Phase 6 — Memory"
  local hkey; hkey="$(keychain HINDSIGHT_API_KEY)"
  local hport; hport="$(envval HINDSIGHT_PORT)"
  if [ -n "$hkey" ] && [ -n "$hport" ]; then
    local code
    # curl exits non-zero on a connection failure regardless of -w, and
    # this assignment isn't inside an if/&&/|| — Phase 4 had the same shape
    # of bug (there via grep, here via a bare failed connection) and was
    # fixed the same way: force the substitution to succeed so a genuinely
    # unreachable Hindsight is reported by the case below, not by killing
    # the whole checklist.
    # A bare GET is not what this needs to send: Hindsight answers one with
    # a bare 200 and an empty body regardless of auth (checked directly —
    # that's a handshake response, not a tool call), which made this report
    # the endpoint as open when it wasn't. A real MCP tool call, unauthenticated,
    # is what actually exercises the auth check — and does correctly 401.
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 -X POST \
      -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
      -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}' \
      "http://127.0.0.1:${hport}/mcp/household/" 2>/dev/null || true)"
    case "${code:-000}" in
      401) grn "  Hindsight refuses an unauthenticated tool call (got 401, as expected)" ;;
      000) ylw "  Could not reach Hindsight on port ${hport}" ;;
      *)   red "  Expected 401 from an unauthenticated tool call, got ${code} — VERIFY the endpoint is actually gated" ;;
    esac
  else
    ylw "  HINDSIGHT_API_KEY or HINDSIGHT_PORT not set — skipping the check"
  fi
  tui_pause

  bold "Phase 7 — Chat, Phase 8 — Voice, Phase 9 — The console"
  dim "  Each is genuinely optional and has its own manual UI steps"
  dim "  (Pocket ID clients, Open WebUI onboarding, HA integration setup)"
  dim "  this CLI cannot drive. See docs/deploy-checklist.md phases 7-9."
  tui_yn "Walked through those manually and they're working" \
    && grn "  noted" || dim "  come back to this once they are"
  tui_pause

  bold "Phase 10 — Unattended operation"
  if launchctl list 2>/dev/null | grep -q "one.a64.novak.stack"; then
    grn "  LaunchAgent is loaded"
  else
    red "  LaunchAgent is NOT loaded — containers won't return after a reboot"
    dim "  launchctl load ~/Library/LaunchAgents/one.a64.novak.stack.plist"
  fi
  tui_pause

  bold "Phase 11 — The test that counts"
  dim "  Pull the plug, or a clean reboot, and watch it come back on its own."
  dim "  Nothing here can check this for you — it's the one phase that has"
  dim "  to actually happen, not just be verified."
  echo
  grn "Checklist walk-through done."
}

cmd_menu() {
  local options=(
    "Status"
    "Ports"
    "Drift / verify"
    "Guided setup — configure what's missing"
    "Deployment checklist — phase by phase, with live checks"
    "Config — view or change a setting"
    "Secrets — view, set, or verify one"
    "Registry — MCP servers the reconciler sees"
    "oMLX — apply models and profiles"
    "Stack — up / update / down / restart / logs"
    "Adopt — pull the repo, then merge the new .env schema"
    "Quit"
  )
  local choice i
  while true; do
    bold "Novak"
    dim "  $REPO_DIR"
    echo
    i=1
    for opt in "${options[@]}"; do printf '%2d) %s\n' "$i" "$opt"; i=$((i+1)); done
    echo
    # A plain `read`, not `select`: select exits its own loop silently on
    # EOF/closed stdin without running its body, which left this in an
    # empty-body-forever spin against the enclosing `while true` — no error,
    # no pause, just the menu redrawing as fast as the terminal could take
    # it. Checking read's own exit status here is what makes closed stdin
    # (piped input running out, Ctrl-D, a script driving this headlessly)
    # exit the menu cleanly instead.
    if ! read -rp "Choose an option (number): " choice; then
      echo; return 0
    fi
    case "$choice" in
      1) tui_run status ;;
      2) tui_run ports ;;
      3) tui_run drift ;;
      4) cmd_guided_setup ;;
      5) cmd_checklist ;;
      6)
        local key; key="$(tui_ask "Key to view or change (blank lists all)")"
        if [ -z "$key" ]; then tui_run config list
        else
          local val; val="$(tui_ask "New value for $key (blank just shows it)")"
          if [ -z "$val" ]; then tui_run config get "$key"
          else tui_run config set "$key" "$val"; fi
        fi
        ;;
      7)
        local sub; sub="$(tui_ask "list / set / show / verify" "list")"
        case "$sub" in
          set)
            local key; key="$(tui_ask "Key")"
            [ -n "$key" ] && tui_run secret set "$key"
            ;;
          show)
            local key; key="$(tui_ask "Key")"
            [ -n "$key" ] && tui_run secret show "$key"
            ;;
          verify) tui_run secret verify ;;
          *)      tui_run secret list ;;
        esac
        ;;
      8) tui_run registry ;;
      9) tui_run omlx apply ;;
      10)
        local sub; sub="$(tui_ask "up / update / down / restart / logs" "up")"
        case "$sub" in
          update)  tui_run update ;;
          down)    tui_run down ;;
          restart) tui_run restart ;;
          logs)    tui_run logs ;;
          *)       tui_run up ;;
        esac
        ;;
      11) tui_run adopt ;;
      12|0|"") return 0 ;;
      *) echo "Not a number on the list."; continue ;;
    esac
    tui_pause || return 0
  done
}

case "${1:-menu}" in
  menu|tui) cmd_menu ;;
  status)   cmd_status ;;
  ports)    cmd_ports ;;
  drift|verify|check) shift; cmd_drift "$@" ;;
  adopt)    cmd_adopt ;;
  omlx)     shift; cmd_omlx "$@" ;;
  doctor)   cmd_status ;;   # same checks up.sh runs, without starting anything
  config)   shift; cmd_config "$@" ;;
  secret)   shift; cmd_secret "$@" ;;
  up)       exec "$REPO_DIR/scripts/up.sh" ;;
  update)   shift; cmd_update "$@" ;;
  down)     compose down ;;
  restart)  shift; compose restart "$@" ;;
  logs)     shift; compose logs -f --tail=100 "$@" ;;
  registry) exec "$NOVAK_HOME/.venv/bin/python" "$REPO_DIR/reconciler/reconcile.py" --dry-run ;;
  -h|--help|help) usage ;;
  *) red "unknown command: $1"; echo; usage; exit 1 ;;
esac
